{
  // Worker "caixa": a casa das paginas de venda do Caixa Livre. A pagina principal
  // (ex-cxlv4) fica na raiz e cada versao nova entra como subpasta, servida pelo
  // mesmo Worker e compartilhando img/, video/ e style.css.
  //   caixa.leticiakratka.com.br/        -> index.html
  //   caixa.leticiakratka.com.br/world/  -> world/index.html (versao em dolar)
  // Substituiu o Worker "cxlv4" em 25/10/2026.
  "name": "caixa",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "./"
  },
  "routes": [
    {
      "pattern": "caixa.leticiakratka.com.br",
      "custom_domain": true
    }
  ]
}
